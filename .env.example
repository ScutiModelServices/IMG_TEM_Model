# Copy to .env (git-ignored). Docker compose and a local run (run.bat) read it from this folder; a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# Admin password: unlocks /admin/, where you create a token per caller; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
TEM_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
TEM_PORT=9190

# Compose only: API copies behind nginx. Each copy loads the model on the GPU (about 4 GB of GPU memory per replica).
TEM_REPLICAS=1

# CPU threads for torch (the GPU does the sampling; this only affects what runs on the CPU). A value saved on the /admin/ page beats this one.
# TEM_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, most steps, device, load at start) are set on the /admin/
# Settings card and saved in settings.json. These variables are only a starting value for run.bat; compose does not
# pass them. A saved value wins.
# TEM_UPDATE_CHECK_HOURS=6
# TEM_MAX_INFLIGHT=
# TEM_CACHE_SIZE=32
# TEM_MAX_STEPS=120
# TEM_DEVICE=cuda
# TEM_WARM=1

# run.bat only (compose sets these itself): bind address.
# TEM_HOST=127.0.0.1
# Where tokens are stored (hashed), the admin page folder, the model code (tools/fetch_tem.py) and the checkpoint folder.
# Docker sets /data/tokens.json, /app/web, /app/_tem_code and /models.
# TEM_TOKENS_FILE=tokens.json
# TEM_WEB_DIR=web
# TEM_CODE_DIR=_tem_code
# TEM_MODELS_DIR=C:\Users\you\.cache\tem
